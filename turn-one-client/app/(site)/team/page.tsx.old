import { useState } from "react"

// Client component for handling image loading with fallback
interface TeamMemberImageProps {
    imageSrc: string;
    name: string;
}

function TeamMemberImage({ imageSrc, name }: TeamMemberImageProps) {
    const [imgSrc, setImgSrc] = useState(imageSrc);
    
    return (
        <div className="w-full h-full">
            <img 
                src={imgSrc} 
                alt={name} 
                className="w-full h-full object-cover object-center"
                onError={() => setImgSrc("https://placehold.co/400x500/171717/e2e2e2?text=Team+Member")}
            />
        </div>
    );
}

