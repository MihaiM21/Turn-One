{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION}"
  },
  "JWT": {
    "Key": "${JWT_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiryInDays": 7
  },
  "SmtpSettings": {
    "Host": "${SMTP_HOST}",
    "Port": "${SMTP_PORT}",
    "EnableSsl": true,
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "${SMTP_FROM_NAME}"
  },
  "AllowedHosts": "*",
  
  "AppSettings": {
    "BaseUrl": "${BASE_URL}"
  }
}
